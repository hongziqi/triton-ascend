[submodule "AscendNPU-IR"]
	path = AscendNPU-IR
	url = https://gitcode.com/Ascend/AscendNPU-IR.git
	# Pin matches triton-ascend main (4eb12142). LLVM 23 adapter is
	# patch/npuir_adapter_to_llvm_23.patch, applied at build time.
[submodule "third_party/triton"]
	path = third_party/triton
	url = https://github.com/triton-lang/triton.git
	# Community Triton v3.7.1 — C++ headers only. Host runtime is pip triton==3.7.1.
