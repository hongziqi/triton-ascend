# Build / install artifacts
build/
build-*/
_C/
*.egg-info/
dist/
wheels/

# Native leftovers (only libtriton_ascend.so under _C is packaged)
*.so
*.so.*
*.dylib
*.a
*.o
*.obj

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/
venv.bak/

# Editors / IDE
.vscode/
.vs/
.idea/
*.swp
*~
.DS_Store

# CMake
CMakeCache.txt
CMakeFiles/
cmake-build-*/
compile_commands.json

# Local LLVM trees (never vendored here)
llvm-project/
llvm-project-*/
.llvm-project/

# Host Triton is installed from PyPI / conda — do not vendor a full clone.
# (Legacy dual-tree experiments may leave this directory around.)
third_party/triton/

# AscendNPU-IR is a git submodule: track the gitlink, ignore local patch dirt
# left after build-time `git apply` (re-applied from patch/ on each build).
AscendNPU-IR/**/*.orig
AscendNPU-IR/**/*.rej

# Test / dump noise
*.log
*.mlir.dump
/tmp_*/
.triton_cache/

# Optional local notes
*.local.md
